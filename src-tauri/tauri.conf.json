{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mdr",
  "identifier": "io.github.timothee-faget.mdr",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown document",
        "role": "Viewer",
        "rank": "Alternate",
        "contentTypes": ["net.daringfireball.markdown"]
      },
      {
        "ext": ["mdown", "mkd", "mkdn"],
        "name": "Markdown document",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
